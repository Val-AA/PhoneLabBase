<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_soft">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/acc_title"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
            android:textStyle="bold" />

        <!-- Estado del acelerómetro -->
        <TextView
            android:id="@+id/tvSensorState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Sensor listo"
            android:textColor="@color/text_secondary" />

        <!-- Tarjeta de valores X, Y, Z -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sensor_values"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="X = 0.00 m/s²"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Y = 0.00 m/s²"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/tvZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Z = 0.00 m/s²"
                    android:textSize="18sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de interpretación del movimiento -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Magnitud actual -->
                <TextView
                    android:id="@+id/tvMagnitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Magnitud: 0.00 m/s²"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                <!-- Clasificación del movimiento -->
                <TextView
                    android:id="@+id/tvMovement"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Movimiento: --"
                    android:textSize="18sp" />

                <!-- Orientación del celular -->
                <TextView
                    android:id="@+id/tvOrientation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Orientación: --"
                    android:textSize="18sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tarjeta de los retos A1 y A2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Registro de movimientos"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                    android:textStyle="bold" />

                <!-- RETO A1: Magnitud máxima -->
                <TextView
                    android:id="@+id/tvMaxMagnitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Magnitud máxima: 0.00 m/s²"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_secondary" />

                <!-- RETO A2: Contador de eventos -->
                <TextView
                    android:id="@+id/tvStrongCount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Movimientos fuertes detectados: 0"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal_secondary" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Información de los retos -->
        <TextView
            android:id="@+id/tvAccChallenge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Reto A1: registrar la magnitud máxima. Reto A2: contar los eventos de movimiento fuerte sin duplicarlos."
            android:textColor="@color/teal_secondary"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
